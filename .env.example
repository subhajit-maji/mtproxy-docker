# ============================
# MTProxy Configuration
# ============================

# A 32-character hexadecimal secret used by clients to connect.
# Example:
# SECRET=0123456789abcdef0123456789abcdef
SECRET=YOUR_32_CHARACTER_HEX_SECRET

# Optional Telegram promotion tag.
# Leave empty if you do not use a promotion tag.
TAG=YOUR_PROMOTION_TAG

# Optional informational values (not used directly by Docker Compose).
DOMAIN=proxy.example.com
IP=203.0.113.10

# MTProxy listens on this port.
PORT=443